# Copy to frontend/.env.local (git-ignored) and restart `npm run dev`.

# Backend API base URL. Default '/api' uses the Vite dev proxy to http://localhost:8000.
# VITE_API_BASE_URL=/api

# Id of an EXISTING user recorded as proposal creator / deal owner (no login yet).
# On a fresh database seeded with scripts/seed_dev_data.py, the seed user is id 1.
VITE_DEALDESK_USER_ID=1
