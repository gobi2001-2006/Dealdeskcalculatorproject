# Copy this file to backend/.env and fill in real values. NEVER commit backend/.env.
# This file contains placeholders only.

# Neon / PostgreSQL connection string (use the SSL-enabled string from the Neon console).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional, for running the PostgreSQL integration tests (see tests/conftest.py).
# Must be a LOCAL database whose name contains "test"; anything else is refused.
# TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/dealdesk_test
